---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, fullAddress, mapsUrl } from '../data/site';
import { telLink } from '../lib/whatsapp';
import { breadcrumbSchema } from '../lib/schema';

const trail = [{ label: 'Inicio', href: '/' }, { label: 'Contacto' }];
---

<BaseLayout
  title="Contacto"
  description={`Contactate con Cortes Argentinos: ${site.address.street}, ${site.address.city}, ${site.address.region}. WhatsApp ${site.phoneDisplay}.`}
  path="/contacto/"
  schema={[breadcrumbSchema(trail)]}
>
  <section class="intro">
    <div class="container">
      <Breadcrumbs trail={trail} class="intro__crumbs" />
      <p class="eyebrow">¿Dónde estamos?</p>
      <h1 class="display intro__title">
        Pasá por <span class="text-red">la carnicería</span>
      </h1>
      <span class="rule" aria-hidden="true"></span>
      <p class="lead muted intro__lead">
        Escribinos por WhatsApp para consultar por un corte, o acercate al local y te
        ayudamos a elegir.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Datos de contacto">
    <div class="container contact">
      <a class="tile tile--wide" href={mapsUrl} target="_blank" rel="noopener noreferrer">
        <span class="tile__label eyebrow">Local</span>
        <address class="tile__value tile__value--address">
          {site.address.street}<br />
          {site.address.city}, {site.address.region}<br />
          <span class="tile__country">{site.address.country}</span>
        </address>
        <span class="tile__action">Abrir en Google Maps →</span>
      </a>

      <a class="tile" href={telLink}>
        <span class="tile__label eyebrow">Teléfono</span>
        <span class="tile__value">{site.phoneDisplay}</span>
        <span class="tile__action">Llamar →</span>
      </a>

      <a
        class="tile"
        href={site.social.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="tile__label eyebrow">Instagram</span>
        <span class="tile__value">{site.social.instagramHandle}</span>
        <span class="tile__action">Seguinos →</span>
      </a>

      <div class="tile tile--wa">
        <span class="tile__label eyebrow">WhatsApp</span>
        <p class="tile__value tile__value--sm">
          La forma más rápida de consultar por un corte, disponibilidad o precio del día.
        </p>
        <WhatsAppButton class="tile__btn" />
      </div>
    </div>
  </section>

  <section class="section section--tight social-band textured" aria-labelledby="redes-title">
    <div class="container social-band__inner">
      <div>
        <h2 class="display social-band__title" id="redes-title">Seguinos</h2>
        <p class="muted social-band__text">
          {
            site.social.facebookUrl
              ? 'Novedades y cortes del día en nuestras redes.'
              : `Novedades y cortes del día en Instagram. También estamos en Facebook como ${site.social.facebookName}.`
          }
        </p>
      </div>
      <SocialLinks showLabels />
    </div>
  </section>

  <p class="visually-hidden">Dirección completa: {fullAddress}.</p>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-xl) var(--space-lg);
    background-color: var(--color-bg-deep);
    border-bottom: 1px solid var(--color-border);
  }

  :global(.intro__crumbs) {
    margin-block-end: var(--space-lg);
  }

  .intro__title {
    margin-block: var(--space-sm);
    font-size: var(--step-4);
  }

  .intro__lead {
    max-width: 44ch;
    margin-block-start: var(--space-md);
  }

  .contact {
    display: grid;
    gap: var(--space-md);
  }

  .tile {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-lg);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration) var(--ease-out),
      background-color var(--duration) var(--ease-out);
  }

  a.tile:hover {
    background: var(--color-bg-raised);
    border-color: var(--color-border-strong);
  }

  .tile__label {
    color: var(--color-text-faint);
  }

  .tile__value {
    font-family: var(--font-condensed);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--color-text);
  }

  .tile__value--address {
    font-style: normal;
  }

  .tile__value--sm {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--step-0);
    color: var(--color-text-muted);
    max-width: 34ch;
  }

  .tile__country {
    font-size: var(--step-0);
    color: var(--color-text-muted);
  }

  .tile__action {
    margin-block-start: var(--space-2xs);
    font-family: var(--font-condensed);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-cream);
  }

  .tile--wa {
    background: linear-gradient(160deg, rgb(196 31 35 / 0.16), transparent 62%),
      var(--color-bg-elevated);
    border-color: rgb(196 31 35 / 0.42);
  }

  .tile--wa :global(.tile__btn) {
    justify-self: start;
    margin-block-start: var(--space-sm);
  }

  .social-band {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
  }

  .social-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .social-band__title {
    font-size: var(--step-2);
  }

  .social-band__text {
    max-width: 46ch;
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
  }

  @media (min-width: 48rem) {
    .contact {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .intro {
      padding-block: var(--space-2xl) var(--space-xl);
    }
  }
</style>
