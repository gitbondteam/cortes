---
import { site } from '../data/site';

export interface Props {
  class?: string;
  showLabels?: boolean;
}

const { class: className = '', showLabels = false } = Astro.props;
---

<ul class={`social ${className}`}>
  <li>
    <a
      class="social__link"
      href={site.social.instagramUrl}
      target="_blank"
      rel="noopener noreferrer me"
    >
      <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 5.68a4.16 4.16 0 1 0 0 8.32 4.16 4.16 0 0 0 0-8.32Zm0 6.86a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4Zm5.3-7.02a.97.97 0 1 1-1.94 0 .97.97 0 0 1 1.94 0Z"
        />
      </svg>
      <span class={showLabels ? 'social__label' : 'visually-hidden'}>
        Instagram {showLabels && site.social.instagramHandle}
      </span>
    </a>
  </li>

  {
    site.social.facebookUrl && (
      <li>
        <a
          class="social__link"
          href={site.social.facebookUrl}
          target="_blank"
          rel="noopener noreferrer me"
        >
          <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M14.1 21.5v-8.3h2.8l.42-3.24H14.1V7.9c0-.94.26-1.58 1.6-1.58h1.72V3.42c-.3-.04-1.32-.13-2.5-.13-2.48 0-4.18 1.51-4.18 4.29v2.38H7.93v3.24h2.81v8.3h3.36Z" />
          </svg>
          <span class={showLabels ? 'social__label' : 'visually-hidden'}>
            Facebook {showLabels && site.social.facebookName}
          </span>
        </a>
      </li>
    )
  }
</ul>

<style>
  .social {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
  }

  .social__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding-inline: 0.7rem;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    transition:
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .social__link:hover {
    color: var(--color-cream);
    border-color: var(--color-cream);
  }

  .social__icon {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
    flex: none;
  }

  .social__label {
    font-family: var(--font-condensed);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
</style>
