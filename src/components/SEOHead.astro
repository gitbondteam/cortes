---
import { site } from '../data/site';

export interface Props {
  title?: string;
  description?: string;
  /** Absolute path, e.g. "/catalogo/". */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** JSON-LD nodes to embed. */
  schema?: unknown[];
}

const {
  title,
  description = site.defaultDescription,
  path,
  image = '/images/og.jpg',
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.brandName}` : site.defaultTitle;
const canonical = new URL(path, site.domain).href;
const imageUrl = new URL(image, site.domain).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta name="theme-color" content="#131313" />
<link rel="icon" href="/favicon/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon/icon-512.png" type="image/png" sizes="512x512" />
<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />

<meta property="og:site_name" content={site.brandName} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="es_AR" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.brandName} — ${site.tagline}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link
  rel="preload"
  href="/fonts/cairo-400.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/oswald-600.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

{
  schema.map((node) => (
    <script type="application/ld+json" set:html={JSON.stringify(node)} is:inline />
  ))
}
